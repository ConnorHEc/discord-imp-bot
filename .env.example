# Fill these locally. Do not paste tokens into Discord/chat or commit .env.
DISCORD_BOT_TOKEN=
STRATZ_API_TOKEN=

# Recommended for your own server: enable Developer Mode, copy server ID.
# When blank, register a global command instead.
DISCORD_GUILD_ID=

# Same player's successful result is cached for 60 seconds.
CACHE_TTL_SECONDS=60
